# Smart Queue System Configuration
PORT=3000
MONGO_URI=mongodb://localhost:27017/smart_queue
JWT_SECRET=your_jwt_secret_key_change_in_production
CLIENT_URL=http://localhost:3000

# GEMINI_API_KEY: Optional/runtime inject
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Nodemailer / SMTP Queue Email Alerts (REQ 6)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="SmartQueue" <no-reply@smartqueue.com>
QUEUE_ALERT_APPROACHING_THRESHOLD=3

# Frontend API URL (Set in Vercel when frontend and backend are hosted separately; leave empty for same-origin)
VITE_API_URL=

